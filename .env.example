# Copy this file to .env and fill in real values for your environment.
# Never commit .env itself — see .gitignore and
# docs/milestones/milestone-9-engineering-foundation-development-setup/08-security-development-practices.md.

# Local Development uses SQLite; see
# docs/milestones/milestone-8-technology-stack-development-architecture/04-database-architecture-strategy.md
# for why SQLite is used for this vertical slice and PostgreSQL is the
# recommended production category.
DATABASE_URL="file:./dev.db"

# Secret used to sign session tokens. Generate a real, random value per
# environment — never reuse the same value across Local Development,
# Development/Test, Staging, and Production.
SESSION_SECRET="replace-with-a-real-random-secret"

# Secret used to sign/verify payment-provider webhook events (see
# src/services/billing/payment-provider.ts). This vertical slice ships a
# mock provider (no real payment account exists in this environment) —
# a real provider integration would set this to that provider's own
# webhook signing secret instead, with no change to core billing logic.
# Generate a real, random value per environment; never commit a real one.
PAYMENT_WEBHOOK_SECRET="replace-with-a-real-random-secret"
