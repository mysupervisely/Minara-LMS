# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real environment values; .env.example is the
# exception, documenting required variables without real secrets (see
# docs/milestones/milestone-9-engineering-foundation-development-setup/08-security-development-practices.md)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local SQLite database (Local Development only — never committed, see
# docs/milestones/milestone-9-engineering-foundation-development-setup/03-development-environment-strategy.md)
prisma/*.db
prisma/*.db-journal
