// Minara-LMS — Prisma schema for the Milestone 10 vertical slice, extended
// by Milestone 13 (content approval/publishing lifecycle + a minimal
// Competency), Milestone 14 (immutable Lesson/Assessment versioning), and
// Milestone 15 (a narrow Externship Eligibility & Placement slice —
// ExternshipEligibility, ClinicalSite, Placement, Evaluation).
//
// This schema implements a deliberately narrow subset of the domain model
// documented in docs/milestones/milestone-5-domain-model-data-architecture/,
// scoped to what the vertical slice in
// docs/milestones/milestone-9-engineering-foundation-development-setup/10-first-implementation-roadmap.md
// and ADR-011 require, applied three times more (Milestones 13, 14, and 15)
// per that same ADR's discipline of proving one narrow slice at a time
// rather than building the full
// docs/milestones/milestone-11-curriculum-management-content-engine/ engine
// (or the full Clinical & Externship Domain Model) at once. It is still NOT
// full curriculum management — there is no Module layer between Course and
// Lesson, no Question Bank, no Program/Course-level versioning (only
// Lesson/Assessment), and no full Competency/Learning Outcome hierarchy
// (only a minimal, Program-scoped Competency, per Milestone 13's Domain
// Impact Review). It is also NOT the full Externship Management system —
// no Employer/Preceptor login, no Site Agreements, no itemized Hours Log —
// per Milestone 15's own Externship Deep Dive.
//
// Database engine: SQLite for local development and this vertical slice's
// demonstrability, per the "database/domain decisions made" note in the
// Milestone 10 deliverables summary. Milestone 8 (Doc 4, Database
// Architecture Strategy) recommends PostgreSQL as the primary-store
// category for production; Prisma's schema language is portable between
// SQLite and PostgreSQL, so moving to Postgres later does not require
// remodeling these entities — only changing the datasource provider and
// re-running migrations.
//
// Role and status values are modeled as plain strings, not native enums:
// SQLite has no enum support in Prisma, and a portable, string-based
// approach avoids retying the schema to a Postgres-specific enum type
// later. The canonical set of allowed values lives in
// src/domain/roles.ts and is validated at the application boundary
// (per Security Development Practices — "validate at every boundary"),
// not left to the database alone.

// Using the classic "prisma-client-js" generator (CommonJS/ESM-interop
// friendly, output to node_modules/@prisma/client) rather than the newer
// ESM-only "prisma-client" generator — the newer generator's
// import.meta.url-based entry point behaves inconsistently across
// Next.js, Vitest, and a plain tsx-run seed script in this environment.
// This is the "boring, well-established choice" Technology Selection
// Principles recommends over novelty for a foundational piece of
// infrastructure (docs/milestones/milestone-8-technology-stack-development-architecture/01-technology-selection-principles.md).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Platform Services bounded context — Identity
// (docs/milestones/milestone-5-domain-model-data-architecture/06-platform-services-domain-model.md)
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions          Session[]
  roleAssignments   RoleAssignment[]
  enrollments       Enrollment[]
  lessonCompletions LessonCompletion[]
  submissions       Submission[]
  gradesEntered     Grade[]            @relation("GradeEnteredBy")
  gradesApproved    Grade[]            @relation("GradeApprovedBy")
  auditLogs         AuditLog[]

  // Milestone 15 (Externship Eligibility & Placement Vertical Slice) —
  // see the Clinical & Externship bounded context below. Named relations
  // because a single User can appear on the same model in more than one
  // capacity (e.g. a Coordinator both creates a Site and later determines
  // eligibility), exactly the pattern Grade's GradeEnteredBy/GradeApprovedBy
  // already established.
  eligibilityDeterminations ExternshipEligibility[] @relation("EligibilityDeterminedBy")
  eligibilityAsStudent      ExternshipEligibility[] @relation("EligibilityStudent")
  clinicalSitesCreated      ClinicalSite[]          @relation("ClinicalSiteCreatedBy")
  placementsAsStudent       Placement[]             @relation("PlacementStudent")
  placementsRequested       Placement[]             @relation("PlacementRequestedBy")
  placementsHoursAttested   Placement[]             @relation("PlacementHoursAttestedBy")
  placementsCompletionSubmitted Placement[]          @relation("PlacementCompletionSubmittedBy")
  placementsCompletionVerified  Placement[]          @relation("PlacementCompletionVerifiedBy")
  evaluationsRecorded       Evaluation[]             @relation("EvaluationRecordedBy")

  @@map("users")
}

// The Authentication Identity / session concept from the Platform Services
// Domain Model — server-side sessions per Security Architecture and
// Authentication & Authorization Architecture (Milestone 6 Doc 4,
// Milestone 8 Doc 5): revocable, not a stateless token.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// The Role Assignment = (Person, Role, Scope) model from the
// Multi-School and Multi-Program Access Model (Milestone 2, Doc 4) and
// Faculty & Administration Domain Model (Milestone 5, Doc 4).
// Scope is expressed as optional references: an Administrator's
// assignment has neither programId nor courseOfferingId (institution-wide,
// per that document); a Program Director's assignment has a programId; a
// Faculty Instructor's assignment has a courseOfferingId (their Teaching
// Assignment); a Student's assignment scopes to Self and carries neither.
model RoleAssignment {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String
  programId        String?
  program          Program?        @relation(fields: [programId], references: [id])
  courseOfferingId String?
  courseOffering   CourseOffering? @relation(fields: [courseOfferingId], references: [id])
  createdAt        DateTime        @default(now())

  @@unique([userId, role, programId, courseOfferingId])
  @@index([userId])
  @@map("role_assignments")
}

// ─────────────────────────────────────────────────────────────────────────
// Academic bounded context
// (docs/milestones/milestone-5-domain-model-data-architecture/02-academic-domain-model.md)
// ─────────────────────────────────────────────────────────────────────────

model Institution {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  schools School[]

  @@map("institutions")
}

model School {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  name          String
  createdAt     DateTime    @default(now())

  programs Program[]

  @@map("schools")
}

// Program-level Certificate/Externship *definitions* (per the ownership
// note in the Academic Domain Model and Service Boundaries) are
// represented as attributes here, not separate entities — the vertical
// slice does not build Certificates or Externship Management (explicitly
// out of scope for Milestone 10), so `requiresExternship` is recorded for
// future phases but has no behavior wired to it yet.
model Program {
  id                 String   @id @default(cuid())
  schoolId           String
  school             School   @relation(fields: [schoolId], references: [id])
  name               String
  slug               String   @unique
  description        String?
  requiresExternship Boolean  @default(false)
  createdAt          DateTime @default(now())

  cohorts         Cohort[]
  courses         Course[]
  enrollments     Enrollment[]
  roleAssignments RoleAssignment[]
  competencies    Competency[]

  // Milestone 15: the Clinical & Externship bounded context is
  // Program-scoped, per ROLE_SCOPE.CLINICAL_COORDINATOR in
  // src/domain/roles.ts and the Clinical & Externship Domain Model
  // (docs/milestones/milestone-5-domain-model-data-architecture/05-clinical-externship-domain-model.md).
  eligibilityDeterminations ExternshipEligibility[]
  clinicalSites             ClinicalSite[]
  placements                Placement[]

  @@map("programs")
}

// Milestone 13 (Curriculum Delivery Vertical Slice) — the one new
// domain concept the slice introduces, kept deliberately minimal per
// docs/milestones/milestone-12-curriculum-delivery-vertical-slice/03-domain-impact-review.md:
// a simple, Program-scoped named record. This is NOT the full
// Milestone 11 four-level chain (Course Outcome → Program Competency →
// Program Learning Outcome → Institution Mission) — it stands in for
// the bottom of that chain only, so the slice can prove a Grade
// Approval moving a competency signal end to end without modeling the
// rest of the hierarchy yet.
model Competency {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  name      String
  createdAt DateTime @default(now())

  // A Lesson Version links to one or more Competencies directly
  // (Milestone 11's Lesson → Course Outcome link, simplified to one
  // join instead of two). Assessment has no direct Competency link —
  // its contribution to Competency Progress is derived via the Lesson
  // Versions of the Course it belongs to; see
  // src/services/academic/competency.ts. Prior to Milestone 14 this
  // related directly to Lesson; every Competency tag now lives on the
  // specific LessonVersion it was chosen for (an edit that changes a
  // Lesson's Competency tags is exactly the kind of change that should
  // produce a new Version, not mutate history).
  lessonVersions LessonVersion[]

  @@map("competencies")
}

model Cohort {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  name      String
  createdAt DateTime @default(now())

  enrollments     Enrollment[]
  courseOfferings CourseOffering[]

  @@map("cohorts")
}

// Curriculum content ownership note (per the Academic Domain Model):
// in a fully built platform, Course/Lesson content is authored in
// Minara-Curriculum and only referenced here for delivery. This
// vertical slice has no Minara-Curriculum integration yet, so Course
// and Lesson content is entered directly through the Administrator
// foundation screens — an explicit, documented simplification, not a
// reversal of that ownership boundary.
model Course {
  id          String   @id @default(cuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id])
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  lessons         Lesson[]
  assessments     Assessment[]
  courseOfferings CourseOffering[]

  @@map("courses")
}

// The delivery-time instance of a Course for a specific Cohort — see
// Academic Domain Model's "Course Offering / Section" reconciliation
// note. A Faculty Instructor's Teaching Assignment is a RoleAssignment
// scoped to a CourseOffering, not a separate entity, per the Faculty &
// Administration Domain Model's "Role Assignment as Teaching Assignment"
// treatment simplified for this slice.
model CourseOffering {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id])
  term      String
  createdAt DateTime @default(now())

  roleAssignments RoleAssignment[]

  @@unique([courseId, cohortId])
  @@map("course_offerings")
}

// Milestone 14 (Content Versioning Vertical Slice): Lesson is the
// stable, immutable-in-shape *identity* a Student enrolls into and a
// Course Offering delivers — the actual deliverable content lives
// entirely on LessonVersion below, per
// docs/milestones/milestone-11-curriculum-management-content-engine/04-versioning-strategy.md's
// entity/version split, which Milestone 12/13's Domain Impact Review
// explicitly deferred as this milestone's next step. As of Migration B
// (prisma/migrations/), Lesson no longer carries title/content/status/
// returnReason/Competency tags at all — a Lesson with zero content of
// its own, only an identity and a pointer, is the whole point: it is
// what makes "create a new Version without touching the old one"
// possible in the first place.
//
// `publishedVersionId` is the single pointer this entire slice exists
// to prove out: the one LessonVersion, among possibly several
// Approved-but-superseded ones, that is actually delivered to
// Students. It is set exactly once per publish action (never
// retroactively changed) — see src/services/academic/content-workflow.ts.
// A null value means this Lesson has never had a version published
// yet (still authoring its first version).
model Lesson {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  order     Int      @default(0)
  createdAt DateTime @default(now())

  versions           LessonVersion[] @relation("LessonVersions")
  publishedVersionId String?
  publishedVersion   LessonVersion?  @relation("LessonPublishedVersion", fields: [publishedVersionId], references: [id])

  @@map("lessons")
}

// The immutable, versioned content of a Lesson at a point in time.
// Once a version's status reaches PUBLISHED, no function in this
// codebase ever writes to that row again — see
// docs/milestones/milestone-11-curriculum-management-content-engine/04-versioning-strategy.md#the-core-rule
// and src/services/academic/content-workflow.ts's guard clauses.
// Multiple versions of the same Lesson can carry status PUBLISHED
// simultaneously (each was legitimately published once); which one is
// *live* is decided solely by Lesson.publishedVersionId, never by
// scanning for status — a deliberate design choice documented in this
// milestone's report so a superseded version's row is never touched
// again for any reason, including "marking it superseded."
model LessonVersion {
  id            String    @id @default(cuid())
  lessonId      String
  lesson        Lesson    @relation("LessonVersions", fields: [lessonId], references: [id])
  versionNumber Int
  title         String
  content       String
  status        String    @default("DRAFT")
  returnReason  String?
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?

  competencies       Competency[]
  completions        LessonCompletion[]
  publishedForLesson Lesson[]           @relation("LessonPublishedVersion")

  @@unique([lessonId, versionNumber])
  @@map("lesson_versions")
}

// See the Lesson/LessonVersion comments above — Assessment follows the
// identical entity/version split, for the identical reason. Submission
// belongs to a specific AssessmentVersion (below), never to Assessment
// directly, so Assessment itself needs no `submissions` relation.
model Assessment {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())

  versions           AssessmentVersion[] @relation("AssessmentVersions")
  publishedVersionId String?
  publishedVersion   AssessmentVersion?  @relation("AssessmentPublishedVersion", fields: [publishedVersionId], references: [id])

  @@map("assessments")
}

model AssessmentVersion {
  id            String     @id @default(cuid())
  assessmentId  String
  assessment    Assessment @relation("AssessmentVersions", fields: [assessmentId], references: [id])
  versionNumber Int
  title         String
  instructions  String
  maxScore      Int        @default(100)
  status        String     @default("DRAFT")
  returnReason  String?
  createdAt     DateTime   @default(now())
  publishedAt   DateTime?

  submissions            Submission[]
  publishedForAssessment Assessment[] @relation("AssessmentPublishedVersion")

  @@unique([assessmentId, versionNumber])
  @@map("assessment_versions")
}

// ─────────────────────────────────────────────────────────────────────────
// Student bounded context
// (docs/milestones/milestone-5-domain-model-data-architecture/03-student-domain-model.md)
// ─────────────────────────────────────────────────────────────────────────

// Per the Student Domain Model: "one Student, many Enrollments." A
// Student's own User row is the anchor identity; each Enrollment is a
// participation in one Program + Cohort. status values: PENDING, ACTIVE,
// WITHDRAWN, COMPLETED (Milestone 5 Doc 3's Enrollment lifecycle).
model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id])
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  submissions Submission[]

  @@unique([studentId, programId])
  @@index([programId])
  @@index([cohortId])
  @@map("enrollments")
}

// The Course Progress concept from the Student Domain Model, narrowed
// for this slice to per-Lesson completion tracking (no Module-level
// rollup, consistent with the Course→Lesson simplification above).
//
// Milestone 14: a completion is tied to the exact LessonVersion a
// Student consumed — "historical student activity remains associated
// with the version they actually used" is this field, full stop. A
// Student's completion of Version 1 is never reinterpreted against
// Version 2's content once Version 2 publishes; see
// src/services/enrollment/enrollment.ts's markLessonComplete. There is
// deliberately no direct `lessonId` here — the parent Lesson is always
// reached via `lessonVersion.lessonId`, so there is exactly one place
// (the Version) that says which Lesson a completion belongs to, never
// two fields that could drift apart.
model LessonCompletion {
  id              String        @id @default(cuid())
  studentId       String
  student         User          @relation(fields: [studentId], references: [id])
  lessonVersionId String
  lessonVersion   LessonVersion @relation(fields: [lessonVersionId], references: [id])
  completedAt     DateTime      @default(now())

  @@unique([studentId, lessonVersionId])
  @@map("lesson_completions")
}

// Milestone 14: a Submission is tied to the exact AssessmentVersion a
// Student attempted — same historical-integrity guarantee, and the
// same single-source-of-truth reasoning, as LessonCompletion above.
// Grade continues to reference Submission by `submissionId` only,
// entirely unchanged by this milestone — a Student's Grade is exactly
// as valid after a newer Assessment Version publishes as it was the
// moment it was approved.
model Submission {
  id                  String            @id @default(cuid())
  assessmentVersionId String
  assessmentVersion   AssessmentVersion @relation(fields: [assessmentVersionId], references: [id])
  studentId           String
  student             User              @relation(fields: [studentId], references: [id])
  enrollmentId        String
  enrollment          Enrollment        @relation(fields: [enrollmentId], references: [id])
  content             String
  submittedAt         DateTime          @default(now())

  grade Grade?

  @@unique([assessmentVersionId, studentId])
  @@map("submissions")
}

// Grade lifecycle: DRAFT (Faculty entered, not yet submitted) →
// SUBMITTED (Faculty submitted for approval) → APPROVED (Program
// Director approved — official) — the approval-gate pattern from
// Faculty Workflows §Approval Points and the Business Rules Catalog's
// Faculty & Staffing Rules, which ADR-011's vertical slice exists to
// prove end-to-end.
model Grade {
  id           String     @id @default(cuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id])
  score        Int
  feedback     String?
  status       String     @default("DRAFT")
  enteredById  String
  enteredBy    User       @relation("GradeEnteredBy", fields: [enteredById], references: [id])
  approvedById String?
  approvedBy   User?      @relation("GradeApprovedBy", fields: [approvedById], references: [id])
  createdAt    DateTime   @default(now())
  submittedAt  DateTime?
  approvedAt   DateTime?

  @@map("grades")
}

// ─────────────────────────────────────────────────────────────────────────
// Clinical & Externship bounded context (Milestone 15 — Externship
// Eligibility & Placement Vertical Slice)
// (docs/milestones/milestone-5-domain-model-data-architecture/05-clinical-externship-domain-model.md,
// narrowed per
// docs/milestones/milestone-15-externship-eligibility-placement-vertical-slice/04-externship-deep-dive.md)
//
// Activates the already-declared CLINICAL_COORDINATOR role (see
// src/domain/roles.ts) rather than introducing a new one. Deliberately
// excludes, per the Deep Dive: Employer as a platform actor/login (an
// Employer/Preceptor is recorded as plain text fields below, not an
// entity with its own identity or account), Site Agreements, itemized
// Hours Logs (a single Coordinator attestation stands in for this
// slice), and any specific hour/eligibility/evaluation-score threshold —
// every such number would be invented, which this milestone's
// instructions explicitly forbid. Where a real number would eventually
// go, the schema instead carries a narrative/status field a Coordinator
// or Program Director fills in with their own judgment.
// ─────────────────────────────────────────────────────────────────────────

// A Program-scoped eligibility determination for a Student's externship
// placement. There is deliberately no automated rule engine — per the
// Deep Dive's item 1, a Coordinator records this by reviewing the
// Student's existing academic record (Enrollment, approved Grades) and
// the platform never claims to compute it. The ABSENCE of a row for a
// given (studentId, programId) is itself meaningful: it means no
// determination has ever been made, which service-layer reads surface
// as "Requirements Pending Verification" — never as a fabricated
// pass/fail default. `status` intentionally excludes any numeric
// threshold (GPA, credit count, etc.); `notes` is where a Coordinator
// records their reasoning against whatever academic record they
// reviewed.
model ExternshipEligibility {
  id             String   @id @default(cuid())
  studentId      String
  student        User     @relation("EligibilityStudent", fields: [studentId], references: [id])
  programId      String
  program        Program  @relation(fields: [programId], references: [id])
  status         String // ELIGIBLE | NOT_YET_ELIGIBLE | BLOCKED
  notes          String?
  determinedById String
  determinedBy   User     @relation("EligibilityDeterminedBy", fields: [determinedById], references: [id])
  determinedAt   DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, programId])
  @@map("externship_eligibilities")
}

// A specific off-campus site a Student can be placed at, to fulfill a
// Program's externship requirement. Per the Deep Dive, Employer is
// represented here as plain contact fields, not a separate entity with
// its own login (Employer Partner remains a dormant, un-activated Role
// — see src/domain/roles.ts) — this is the single largest scope
// narrowing in this milestone, made deliberately, not by oversight.
// status lifecycle: PENDING (newly recorded) -> ACTIVE (Coordinator has
// approved it for placements) -> INACTIVE (no longer used).
model ClinicalSite {
  id            String   @id @default(cuid())
  programId     String
  program       Program  @relation(fields: [programId], references: [id])
  name          String
  employerName  String
  contactName   String?
  contactInfo   String?
  capacity      Int      @default(1)
  status        String   @default("PENDING")
  createdById   String
  createdBy     User     @relation("ClinicalSiteCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  placements Placement[]

  @@index([programId])
  @@map("clinical_sites")
}

// The record of one Student's placement at one Clinical Site. Two
// independent status fields, deliberately not conflated, per this
// milestone's explicit instruction to distinguish "evaluation
// completed," "placement completed," and "completion verified":
//
// `status` (REQUESTED -> APPROVED -> ACTIVE -> COMPLETED) is the
// placement's own lifecycle — "evaluation completed" is not tracked as
// a field here at all, it is simply whether a FINAL-type Evaluation row
// exists for this Placement (queried, not stored, so it can never drift
// out of sync with the Evaluation rows themselves).
//
// `completionStatus` (NOT_SUBMITTED -> SUBMITTED -> VERIFIED, or ->
// RETURNED for the remediation loop) is the Coordinator + Program
// Director joint approval gate — the exact same shape as
// LessonVersion/AssessmentVersion's status + returnReason pattern from
// Milestones 13/14, applied here a third time rather than reinvented.
// `status` only advances to COMPLETED when `completionStatus` reaches
// VERIFIED — that transition is the one place the two fields are linked,
// enforced in src/services/externship/externship.ts, never left to two
// independently-writable fields to agree by convention.
//
// `hoursAttestedAt`/`hoursAttestedById` stand in for the itemized Hours
// Log the Deep Dive defers (#9) — a single Coordinator attestation that
// hours are complete, with no specific hour count enforced by the
// platform (that number is ⚠️ Needs Verification pending
// Minara-Curriculum, per ADR-008 and this milestone's own constraints).
model Placement {
  id             String    @id @default(cuid())
  studentId      String
  student        User      @relation("PlacementStudent", fields: [studentId], references: [id])
  programId      String
  program        Program   @relation(fields: [programId], references: [id])
  clinicalSiteId String
  clinicalSite   ClinicalSite @relation(fields: [clinicalSiteId], references: [id])

  preceptorName    String?
  preceptorContact String?

  status String @default("REQUESTED")

  hoursAttestedAt   DateTime?
  hoursAttestedById String?
  hoursAttestedBy   User?     @relation("PlacementHoursAttestedBy", fields: [hoursAttestedById], references: [id])

  completionStatus       String    @default("NOT_SUBMITTED")
  completionReturnReason String?
  completionSubmittedAt   DateTime?
  completionSubmittedById String?
  completionSubmittedBy   User?     @relation("PlacementCompletionSubmittedBy", fields: [completionSubmittedById], references: [id])
  completionVerifiedAt    DateTime?
  completionVerifiedById  String?
  completionVerifiedBy    User?     @relation("PlacementCompletionVerifiedBy", fields: [completionVerifiedById], references: [id])

  requestedById String
  requestedBy   User   @relation("PlacementRequestedBy", fields: [requestedById], references: [id])
  createdAt     DateTime @default(now())

  evaluations Evaluation[]

  @@index([studentId])
  @@index([programId])
  @@index([clinicalSiteId])
  @@map("placements")
}

// A Midpoint or Final evaluation recorded against a Placement.
// Deliberately minimal, per the Deep Dive's #12–14: free-text content
// plus a single overall outcome flag, not a structured multi-criteria
// rubric (a full rubric/competency-checklist engine remains Future).
// `recordedById` is always the Coordinator's User id — never an
// Employer's — since this slice records the evaluation on the
// Employer/Preceptor's behalf rather than giving them direct
// self-service submission (see ClinicalSite's comment above for the
// same narrowing rationale).
model Evaluation {
  id          String   @id @default(cuid())
  placementId String
  placement   Placement @relation(fields: [placementId], references: [id])
  type        String // MIDPOINT | FINAL
  content     String
  outcome     String   @default("SATISFACTORY") // SATISFACTORY | CONCERNS_IDENTIFIED
  recordedById String
  recordedBy  User     @relation("EvaluationRecordedBy", fields: [recordedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([placementId])
  @@map("evaluations")
}

// ─────────────────────────────────────────────────────────────────────────
// Platform Services bounded context — Audit
// (docs/milestones/milestone-2-user-roles-permission-architecture/05-audit-accountability-framework.md)
// ─────────────────────────────────────────────────────────────────────────

// Append-only by convention: no application code path updates or
// deletes an AuditLog row (per ADR-005) — enforced at the application
// layer in src/services/audit/, since SQLite has no row-level
// permission system to enforce it at the database layer the way
// Milestone 8's Database Architecture Strategy recommends for
// production Postgres.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
